{
    "name": "winterphp/framework",
    "description": "Winter — framework PHP 8 à stéréotypes, inspiré de Spring Boot",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "framework",
        "php",
        "spring-boot",
        "dependency-injection",
        "attributes",
        "doctrine",
        "twig"
    ],
    "homepage": "https://github.com/winterphp/framework",
    "authors": [
        {
            "name": "Mamadou Aly Sy",
            "email": "sy.aly.mamadou@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/winterphp/framework/issues",
        "source": "https://github.com/winterphp/framework",
        "docs": "https://github.com/winterphp/docs"
    },
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "psr/container": "^2.0",
        "php-di/php-di": "^7.0",
        "nikic/fast-route": "^1.3",
        "symfony/http-foundation": "^7.0",
        "symfony/console": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/property-access": "^7.0",
        "symfony/cache": "^7.0",
        "symfony/var-exporter": "^7.0 || ^8.0",
        "twig/twig": "^3.10",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "doctrine/orm": "^3.3",
        "doctrine/migrations": "^3.7",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Winter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Winter\\Tests\\": "tests/",
            "Winter\\Tests\\Fixtures\\App\\": "tests/Fixtures/App/src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    }
}
