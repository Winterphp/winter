{
    "name": "winterphp/skeleton",
    "description": "Squelette d'application Winter",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "winter",
        "skeleton",
        "framework",
        "php",
        "starter"
    ],
    "homepage": "https://github.com/winterphp/skeleton",
    "authors": [
        {
            "name": "Mamadou Aly Sy",
            "email": "sy.aly.mamadou@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/winterphp/skeleton/issues",
        "source": "https://github.com/winterphp/skeleton",
        "docs": "https://github.com/winterphp/docs"
    },
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "winterphp/framework": "^0.1"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    }
}
