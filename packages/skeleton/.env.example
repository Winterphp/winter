APP_NAME=Winter
APP_ENV=dev
# Profils supplémentaires, séparés par des virgules (ex. staging,debug)
APP_PROFILES=
APP_DEBUG=true
APP_SECRET=change-me
APP_TIMEZONE=UTC

# SQLite, MySQL, PostgreSQL…
# sqlite:///%kernel.project_dir%/var/data.sqlite n'est pas interprété : utilisez un chemin absolu.
DATABASE_URL=sqlite:////tmp/winter.sqlite

# session, jwt ou both
AUTH_MODE=session
SESSION_NAME=winter_session
# native en production, array en test
SESSION_STORAGE=native
# true en production (HTTPS). Commenté, le défaut suit APP_ENV : true en prod, false sinon.
# SESSION_SECURE=false
CSRF_ENABLED=true

JWT_SECRET=change-me-with-at-least-32-characters
JWT_TTL=3600

LOG_LEVEL=debug
