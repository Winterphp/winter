#!/usr/bin/env php
<?php

declare(strict_types=1);

$autoloads = [
    \dirname(__DIR__) . '/vendor/autoload.php',
    \dirname(__DIR__, 3) . '/vendor/autoload.php',
];

foreach ($autoloads as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

exit(\Winter\Application::cli(\dirname(__DIR__)));
